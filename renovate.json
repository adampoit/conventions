{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "labels": ["automation"],
  "enabledManagers": ["github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^repo-conventions-workflow\\/convention\\.ps1$/"],
      "matchStrings": [
        "(?<depName>actions/checkout)@(?<currentValue>[^'\\s]+)",
        "(?<depName>actions/setup-dotnet)@(?<currentValue>[^'\\s]+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
