{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enableVulnerabilityAlerts"],
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "labels": ["automation"],
  "schedule": ["* 0-6 * * 2"],
  "enabledManagers": ["github-actions", "npm", "custom.regex"],
  "packageRules": [
    {
      "description": "Group all non-major updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^repo-conventions-workflow\\/convention\\.ps1$/"],
      "matchStrings": [
        "(?m)^\\$checkoutAction = '(?<depName>actions/checkout)@(?<currentValue>[^'\\s]+)'",
        "(?m)^\\$setupDotnetAction = '(?<depName>actions/setup-dotnet)@(?<currentValue>[^'\\s]+)'"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^v(?<major>\\d+)$"
    }
  ]
}
